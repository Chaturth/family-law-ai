# Copy to .env and fill in. Without GEMINI_API_KEY the app runs in "offline-demo" mode
# (rule-based fallbacks) so you can demo everything before the key arrives.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Max Gemini calls per UTC day; after this the app falls back to offline-demo mode until tomorrow.
GEMINI_DAILY_LIMIT=200
# Optional: your own Fernet key. If empty, one is generated into data/secret.key on first run.
FERNET_KEY=
